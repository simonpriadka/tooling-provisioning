<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly.qa</groupId>
        <artifactId>tooling-provisioning</artifactId>
        <version>2.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>tooling-sbom-verification</artifactId>
    <packaging>jar</packaging>

    <name>WildFly SBOM Verification</name>
    <description>
        Verifies that a WildFly CycloneDX SBOM correctly represents
        the artifacts installed on disk.
        Based on https://github.com/jfdenise/wildfly-sbom-checker.
    </description>

    <properties>
        <version.cyclonedx-core-java>13.1.0</version.cyclonedx-core-java>
        <version.snakeyaml>2.3</version.snakeyaml>
        <version.maven-shade-plugin>3.6.0</version.maven-shade-plugin>
    </properties>

    <dependencies>
        <!-- CycloneDX SBOM parser / model -->
        <dependency>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-core-java</artifactId>
            <version>${version.cyclonedx-core-java}</version>
        </dependency>

        <!-- YAML parsing for manifest.yaml -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${version.snakeyaml}</version>
        </dependency>

        <!-- Unit tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat JAR so the checker can be run standalone -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${version.maven-shade-plugin}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.wildfly.sbom.SbomChecker</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
